rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /thumbnails/{studentId}/{fileName} {
      // Anyone can view a thumbnail (it's just a cover image, not sensitive).
      allow read: if true;
      // Only a signed-in user can upload. In practice only the teacher's
      // UI calls this — students never see the upload button.
      allow write: if request.auth != null;
    }
  }
}
